<!--! use the same map as the formation-dependent wagon recolouring, modulo to number of candidates
      initialise alt var 41 here as the candidate graphics chain hasn't run yet -->
<tal:model_common condition="model_variant.is_default_model_variant">
switch (FEAT_TRAINS, SELF, ${unit.unit_id_from_common_model_id}_switch_graphics_variant_choose_randomised_wagon, [
        initialise_alt_var_41_with_badge_predicate(badgetype("_ih_formation_ruleset/vehicle_reports_as/${model_variant.gestalt_graphics.badge_slug_for_alt_var_41_predicate}")),
        switch_pseudo_random_freight_ruleset_map_for_random_choice_${model_variant.gestalt_graphics.formation_ruleset}()
        % ${len(model_variant.wagon_randomisation_candidates)}
    ]) {
    <tal:randomisation_candidates repeat="randomisation_candidate model_variant.wagon_randomisation_candidates">
        ${repeat.randomisation_candidate.index}: ${repeat.randomisation_candidate.index};
    </tal:randomisation_candidates>
}
<!--! note that we provide '_switch_graphics' not '_switch_graphics_vehicle' as there are no precursor graphics entry switches for randomised wagons
      we'll ultimately chain instead to the selected candidate's graphics entry switch
      note that graphics_entry_switches.pynml shouldn't be used with this template
      randomised vehicles chain via the selected candidate's graphics entry switch, so they don't need their own graphics entry switch  -->
switch (FEAT_TRAINS, SELF, ${unit.graphics_switch_entry_point_stem}_switch_graphics,
            ${unit.unit_id_from_common_model_id}_switch_graphics_variant_choose_randomised_wagon()) {
    <tal:randomisation_candidates repeat="randomisation_candidate model_variant.wagon_randomisation_candidates">
        <!--! N.B. id interpolation is untested with articulated vehicles and random articulated vehicles may simply not work at all :P -->
        ${repeat.randomisation_candidate.index}: ${randomisation_candidate.example_model_variant.units[model_variant.units.index(unit)].graphics_switch_entry_point_stem}_switch_graphics;
    </tal:randomisation_candidates>
}
</tal:model_common>

<tal:buy_menu_lead_unit_only condition="unit.is_not_trailing_part">
    <tal:model_common condition="model_variant.is_default_model_variant">
        <tal:purchase_variants repeat="purchase_entry model_variant.catalogue">
            spriteset(${model_variant.model_id}_ss_purchase_${repeat.purchase_entry.index}, "${graphics_path}${model_variant.model_id}.png") {
                ${model_variant.get_nml_for_spriteset_template(y_offset=purchase_entry.livery_def.relative_spriterow_num * 30)}
            }
        </tal:purchase_variants>
        switch (FEAT_TRAINS, SELF, ${unit.unit_id_from_common_model_id}_switch_graphics_purchase, vehicle_type_id) {
            <tal:purchase_variants repeat="purchase_entry model_variant.catalogue">
                ${purchase_entry.unit_numeric_ids[0]}: ${model_variant.model_id}_ss_purchase_${repeat.purchase_entry.index};
            </tal:purchase_variants>
        }
    </tal:model_common>
</tal:buy_menu_lead_unit_only>

switch (FEAT_TRAINS, SELF, ${unit.id}_switch_colour_mapping, vehicle_type_id) {
    <tal:forced_remap switch="model_variant.catalogue_entry.livery_def.remap_to_cc is not None">
        <tal:remap case="True">
            ${unit.numeric_id}: return base_sprite_2cc + 16 * ${model_variant.catalogue_entry.livery_def.remap_to_cc['company_colour2']} + ${model_variant.catalogue_entry.livery_def.remap_to_cc['company_colour1']};
        </tal:remap>
        <tal:no_remap case="False">
            ${unit.numeric_id}:return base_sprite_2cc + 16 * company_colour2 + company_colour1; <!--! apply regular 1CC and 2CC -->
        </tal:no_remap>
    </tal:forced_remap>
}
